' ════════════════════════════════════════════════════════════════════
' RELACIONES - HERENCIA (BACKEND)
' ════════════════════════════════════════════════════════════════════

Usuarios <|-- Alumnos : hereda
Usuarios <|-- Profesores : hereda
Usuarios <|-- Administradores : hereda

' ════════════════════════════════════════════════════════════════════
' RELACIONES - BACKEND
' ════════════════════════════════════════════════════════════════════

Alumnos "1" -- "*" CursosAlumnos : inscrito en
CursosAlumnos "*" -- "1" Cursos : contiene

Profesores "1" -- "*" ProfesoresCursos : imparte
ProfesoresCursos "*" -- "1" Cursos : en

Profesores "1" -- "*" Cursos : crea
Profesores "1" -- "*" Ejercicios : autor de
Profesores "1" -- "*" Videos : autor de
Profesores "1" -- "*" Apuntes : autor de

Cursos "1" -- "*" Ejercicios : contiene
Cursos "1" -- "*" Videos : contiene
Cursos "1" -- "*" Apuntes : contiene
Cursos "1" -- "*" ComentarioAlumnoCurso : recibe

Alumnos "1" -- "*" EjerciciosAlumnos : entrega
EjerciciosAlumnos "*" -- "1" Ejercicios : resuelto

Alumnos "1" -- "*" ApuntesAlumnos : valora
ApuntesAlumnos "*" -- "1" Apuntes : valorado

Alumnos "1" -- "*" PuntuacionesEjercicios : recibe
PuntuacionesEjercicios "*" -- "1" Ejercicios : califica

Usuarios "1" -- "*" Notificaciones : recibe
Alumnos "1" -- "*" ComentarioAlumnoCurso : comenta

' ════════════════════════════════════════════════════════════════════
' RELACIONES - FRONTEND
' ════════════════════════════════════════════════════════════════════

LoginGrid --|> useAuthStore : usa
RegisterGrid --|> useAuthStore : usa
ProfileGrid --|> useAuthStore : usa

Home --|> useAuthStore : usa
Home --|> useToastStore : usa
Home --|> useModalStore : usa

CourseGrid --|> useAuthStore : usa
CourseGrid --|> useToastStore : usa

Nav --|> useAuthStore : usa
Nav --|> useToastStore : usa

AddCourseGrid --|> useAuthStore : usa
AddCourseGrid --|> useToastStore : usa

GradeExercisesGrid --|> useAuthStore : usa
GradeExercisesGrid --|> useToastStore : usa

Avatar --|> useAuthStore : usa

' ════════════════════════════════════════════════════════════════════
' RELACIONES - FRONTEND A BACKEND
' ════════════════════════════════════════════════════════════════════

LoginGrid ..> Usuarios : autentica
RegisterGrid ..> Usuarios : crea
ProfileGrid ..> Alumnos : edita
ProfileGrid ..> Profesores : edita

Home ..> Cursos : consulta
Home ..> Apuntes : consulta

CourseGrid ..> Cursos : consulta
CourseGrid ..> Ejercicios : consulta
CourseGrid ..> Videos : consulta
CourseGrid ..> ComentarioAlumnoCurso : consulta
CourseGrid ..> CursosAlumnos : modifica

AddCourseGrid ..> Cursos : crea

GradeExercisesGrid ..> Ejercicios : consulta
GradeExercisesGrid ..> EjerciciosAlumnos : consulta
GradeExercisesGrid ..> PuntuacionesEjercicios : crea

Nav ..> Notificaciones : consulta

note right of Usuarios
  Base de jerarquía de usuarios
  (+) Público | (-) Privado | (#) Protegido
end note

note right of Cursos
  Gestión de cursos con categoría ENUM
  y sistema de valoración
end note

note right of Apuntes
  Contenido compartido con sistema
  de likes y valoración dinámica
end note

note right of Home
  Dashboard personalizado según tipo:
  Alumno | Profesor | Administrador
end note

note right of useAuthStore
  Gestión de autenticación persistente
  en localStorage + token
end note

@enduml