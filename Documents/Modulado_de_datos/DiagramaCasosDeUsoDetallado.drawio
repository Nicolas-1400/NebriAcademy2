        <mxCell id="8l5-s3TlvwDMKNyAavH5-15" parent="8l5-s3TlvwDMKNyAavH5-13" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;7,0&quot; data-index-in-node=&quot;188&quot;&gt;Actores:&lt;/b&gt; Alumno, Profesor, Administrador" vertex="1">
          <mxGeometry height="30" width="514" y="75" as="geometry" />
