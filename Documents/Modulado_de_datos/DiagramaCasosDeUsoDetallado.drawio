        <mxCell id="Z3sxpDSgYonda_kxHlEB-4" parent="Z3sxpDSgYonda_kxHlEB-1" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Precondiciones:&lt;/b&gt;&amp;nbsp;El usuario debe estar registrado en el sistema y tener su cuenta verificada." vertex="1">
          <mxGeometry height="34" width="507" y="103" as="geometry" />
        </mxCell>
        <mxCell id="Z3sxpDSgYonda_kxHlEB-7" parent="Z3sxpDSgYonda_kxHlEB-1" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Curso normal del caso de uso:&lt;/b&gt;&amp;nbsp;&lt;div&gt;1.&amp;nbsp;El sistema muestra un formulario solicitando correo electrónico y contraseña.&lt;/div&gt;&lt;div&gt;2.&amp;nbsp;El usuario introduce sus credenciales y pulsa el botón de entrar.&lt;/div&gt;&lt;div&gt;3.&amp;nbsp;El sistema busca al usuario en la base de datos y valida que la contraseña sea correcta.&lt;/div&gt;&lt;div&gt;4.&amp;nbsp;El sistema concede el acceso y redirige al usuario a su página &quot;Home&quot; correspondiente.&lt;/div&gt;" vertex="1">
          <mxGeometry height="104" width="507" y="137" as="geometry" />
        </mxCell>
        <mxCell id="Z3sxpDSgYonda_kxHlEB-21" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=37;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Nombre:&lt;/b&gt;&amp;nbsp; Crear curso&lt;div&gt;&lt;b&gt;ID:&lt;/b&gt;&amp;nbsp;CU-CUR-01&lt;/div&gt;" vertex="1">
          <mxGeometry height="392" width="508" x="646" y="148" as="geometry">
            <mxRectangle height="26" width="54" x="205" y="238" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Z3sxpDSgYonda_kxHlEB-22" parent="Z3sxpDSgYonda_kxHlEB-21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Descripción:&lt;/b&gt;&amp;nbsp;El profesor crea un curso rellenando la información obligatoria y opcionalmente, añade contenido." vertex="1">
          <mxGeometry height="36" width="508" y="37" as="geometry" />
        </mxCell>
        <mxCell id="Z3sxpDSgYonda_kxHlEB-23" parent="Z3sxpDSgYonda_kxHlEB-21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Actores:&lt;/b&gt;&amp;nbsp;Profesor" vertex="1">
          <mxGeometry height="30" width="508" y="73" as="geometry" />
        </mxCell>
        <mxCell id="Z3sxpDSgYonda_kxHlEB-24" parent="Z3sxpDSgYonda_kxHlEB-21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Precondiciones:&lt;/b&gt;&amp;nbsp;El profesor debe haber iniciado sesión&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="508" y="103" as="geometry" />
        </mxCell>
        <mxCell id="Z3sxpDSgYonda_kxHlEB-25" parent="Z3sxpDSgYonda_kxHlEB-21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;line-height: 140%;&quot;&gt;&lt;b&gt;Curso normal del caso de uso:&lt;/b&gt;&amp;nbsp;&lt;div&gt;&lt;ol&gt;&lt;li&gt;El profesor pulsa el botón &quot;Añadir curso&quot; en la barra de navegación superior.&lt;/li&gt;&lt;li&gt;El sistema muestra el formulario &quot;Crear Curso&quot; con los campos básicos y los paneles opcionales de contenido.&lt;/li&gt;&lt;li&gt;El profesor rellena obligatoriamente el nombre, categoría, nivel y descripción del curso, y selecciona una imagen de fondo.&lt;/li&gt;&lt;li&gt;&lt;b&gt;[Extend: Añadir contenido al curso] &lt;/b&gt;Opcionalmente, el profesor rellena los contenedores de &quot;Añadir Apunte&quot;, &quot;Añadir Vídeo&quot; o &quot;Añadir Ejercicio&quot; adjuntando los archivos correspondientes.&lt;/li&gt;&lt;li&gt;El profesor pulsa el botón rojo de &quot;Crear curso&quot;.&lt;/li&gt;&lt;li&gt;El sistema valida que los campos obligatorios estén completos y el formato de los archivos sea correcto (máx. 20 MB).&lt;/li&gt;&lt;li&gt;El sistema guarda el curso en la base de datos y redirige al profesor a la página del nuevo curso.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="259" width="508" y="133" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-1" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=37;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Nombre:&lt;/b&gt;&amp;nbsp;Gestionar cuentas&lt;div&gt;&lt;b&gt;ID:&lt;/b&gt;&amp;nbsp;CU-AUTH-03&lt;/div&gt;" vertex="1">
          <mxGeometry height="304" width="511" x="60" y="1033" as="geometry">
            <mxRectangle height="26" width="54" x="205" y="238" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-2" parent="wQSY34oqyfMD28N-P1ry-1" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Descripción:&lt;/b&gt;&amp;nbsp;El administrador accede a un panel de control para visualizar y administrar a todos los usuarios de la plataforma." vertex="1">
          <mxGeometry height="30" width="511" y="37" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-3" parent="wQSY34oqyfMD28N-P1ry-1" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Actores:&lt;/b&gt;&amp;nbsp;Administrador" vertex="1">
          <mxGeometry height="30" width="511" y="67" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-4" parent="wQSY34oqyfMD28N-P1ry-1" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Precondiciones:&lt;/b&gt;&amp;nbsp;El administrador debe estar autenticado en el sistema" vertex="1">
          <mxGeometry height="30" width="511" y="97" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-5" parent="wQSY34oqyfMD28N-P1ry-1" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;line-height: 140%;&quot;&gt;&lt;b&gt;Curso normal del caso de uso:&lt;/b&gt;&amp;nbsp;&lt;div&gt;&lt;ol&gt;&lt;li&gt;El administrador entra a la página &quot;Cuentas&quot; desde su barra de navegación.&lt;/li&gt;&lt;li&gt;El sistema carga y muestra las tablas con los alumnos y los profesores registrados.&lt;/li&gt;&lt;li&gt;Opcionalmente, el administrador decide añadir a alguien al sistema. &lt;b&gt;[Extend: Crear usuarios - Ver ficha CU-AUTH-04]&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;[Extend: Editar usuario]&lt;/b&gt; Opcionalmente, el administrador selecciona una celda de un usuario de la tabla, y la modifica, y el sistema guarda los cambios.&lt;/li&gt;&lt;li&gt;&lt;b&gt;[Extend: Desactivar usuario]&lt;/b&gt; Opcionalmente, el administrador selecciona un usuario y pulsa en &quot;borrar&quot; El sistema borra la cuenta de la base de datos.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="177" width="511" y="127" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-6" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=37;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Nombre:&lt;/b&gt;&amp;nbsp;Registrarse&lt;div&gt;&lt;b&gt;ID:&lt;/b&gt;&amp;nbsp;CU-AUTH-02&lt;/div&gt;" vertex="1">
          <mxGeometry height="568" width="514" x="60" y="420" as="geometry">
            <mxRectangle height="26" width="54" x="205" y="238" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-7" parent="wQSY34oqyfMD28N-P1ry-6" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Descripción:&lt;/b&gt;&amp;nbsp;El usuario crea una cuenta en la plataforma. El proceso varía dependiendo de si es un alumno externo, un alumno de la familia Nebrija o un profesor." vertex="1">
          <mxGeometry height="39" width="514" y="37" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-8" parent="wQSY34oqyfMD28N-P1ry-6" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Actores:&lt;/b&gt;&amp;nbsp;Alumno, Profesor" vertex="1">
          <mxGeometry height="30" width="514" y="76" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-9" parent="wQSY34oqyfMD28N-P1ry-6" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Precondiciones:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Para los alumnos Nebrija y profesores, el administrador debe haber generado previamente un código de verificación asociado a su correo institucional.&lt;/span&gt;&lt;div&gt;&lt;div&gt;Para alumnos externos&amp;nbsp;debe disponer de un correo electrónico no registrado previamente en el sistema.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="68" width="514" y="106" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-10" parent="wQSY34oqyfMD28N-P1ry-6" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;line-height: 140%;&quot;&gt;&lt;div&gt;&lt;b&gt;Curso normal del caso de uso (Ruta de alumnos Nebrija y Profesores):&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;El usuario selecciona la opción de registrarse y el sistema carga la página &quot;PreRegister&quot;.&lt;/li&gt;&lt;li&gt;El sistema muestra la pregunta &quot;¿Eres estudiante de la familia Nebrija?&quot; con tres opciones: Sí, No y Soy profesor.&lt;/li&gt;&lt;li&gt;El usuario pulsa &quot;Sí&quot; o &quot;Soy profesor&quot;.&lt;/li&gt;&lt;li&gt;El sistema redirige a la página de verificación.&lt;/li&gt;&lt;li&gt;El usuario introduce su correo universitario y el código proporcionado presencialmente por la universidad.&lt;/li&gt;&lt;li&gt;&lt;b&gt;[Include: Verificar cuenta] &lt;/b&gt;El sistema comprueba en la base de datos que el correo existe y que el código es correcto.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Al ser correcto, el sistema redirige a la página correspondiente (&quot;Register/alumnonebrija&quot; o &quot;Register/profesor&quot;).&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;El usuario rellena el formulario con sus datos y lo envía.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;El sistema registra la cuenta en la base de datos.&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="294" width="514" y="174" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-11" parent="wQSY34oqyfMD28N-P1ry-6" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Flujos alternativos:&amp;nbsp;&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3.a. Ruta de Alumno Externo: Si en el paso 2 el usuario pulsa &quot;No&quot;.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;4.a. El sistema redirige directamente a la página &quot;Register/alumnoexterno (saltándose&amp;nbsp;la &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;verificación).&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;5.a. El usuario rellena el formulario y lo envía.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;6.a. El sistema registra la cuenta y muestra un mensaje de éxito.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="514" y="468" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-17" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=37;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Nombre:&lt;/b&gt;&amp;nbsp;Crear usuarios&lt;div&gt;&lt;b&gt;ID:&lt;/b&gt;&amp;nbsp;CU-AUTH-04&lt;/div&gt;" vertex="1">
          <mxGeometry height="288" width="512" x="60" y="1358" as="geometry">
            <mxRectangle height="26" width="54" x="205" y="238" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-18" parent="wQSY34oqyfMD28N-P1ry-17" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Descripción:&lt;/b&gt;&amp;nbsp;El administrador genera en el sistema las credenciales de acceso (correo institucional y código de verificación) para un alumno o un profesor." vertex="1">
          <mxGeometry height="36" width="512" y="37" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-19" parent="wQSY34oqyfMD28N-P1ry-17" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Actores:&lt;/b&gt;&amp;nbsp;Administrador" vertex="1">
          <mxGeometry height="30" width="512" y="73" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-20" parent="wQSY34oqyfMD28N-P1ry-17" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Precondiciones:&lt;/b&gt;&amp;nbsp;El administrador debe estar autenticado en el sistema y el usuario físico debe haber solicitado su cuenta presencialmente." vertex="1">
          <mxGeometry height="40" width="512" y="103" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-21" parent="wQSY34oqyfMD28N-P1ry-17" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;line-height: 140%;&quot;&gt;&lt;b&gt;Curso normal del caso de uso:&lt;/b&gt;&amp;nbsp;&lt;br&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;El administrador accede a la página &quot;Cuentas&quot; y selecciona la opción de crear cuenta.&lt;/li&gt;&lt;li&gt;El sistema pide un correo y el tipo del usuario (alumno o profesor).&lt;/li&gt;&lt;li&gt;El administrador introduce el correo institucional y selecciona el tipo de usuario.&lt;/li&gt;&lt;li&gt;El sistema genera un código y guarda la combinación de correo y código en la base de datos, dejandola en estado &quot;Pendiente de registro&quot;.&lt;/li&gt;&lt;li&gt;El administrador entrega el código de verificación al usuario de forma presencial.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="512" y="143" as="geometry" />
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-22" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=37;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Nombre:&lt;/b&gt;&amp;nbsp;Editar perfil&lt;div&gt;&lt;b&gt;ID:&lt;/b&gt;&amp;nbsp;CU-AUTH-05&lt;/div&gt;" vertex="1">
          <mxGeometry height="308" width="513" x="60" y="1686" as="geometry">
            <mxRectangle height="26" width="54" x="205" y="238" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wQSY34oqyfMD28N-P1ry-23" parent="wQSY34oqyfMD28N-P1ry-22" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Descripción:&lt;/b&gt;&amp;nbsp;El usuario modifica su información personal (contraseña, nº de tarjeta, localidad, etc) dentro de &quot;Mi perfil&quot;." vertex="1">
