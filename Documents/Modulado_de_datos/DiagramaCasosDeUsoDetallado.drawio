        <mxCell id="sAzKu8gqVW-PRkbQ9jT1-5" parent="sAzKu8gqVW-PRkbQ9jT1-4" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;6,0&quot; data-index-in-node=&quot;55&quot;&gt;Descripción:&lt;/b&gt; El alumno accede al directorio general de docentes de la plataforma y utiliza herramientas de búsqueda para encontrar profesores según su especialidad." vertex="1">
          <mxGeometry height="38" width="514" y="37" as="geometry" />
