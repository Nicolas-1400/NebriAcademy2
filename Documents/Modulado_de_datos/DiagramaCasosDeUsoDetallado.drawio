        <mxCell id="8l5-s3TlvwDMKNyAavH5-14" parent="8l5-s3TlvwDMKNyAavH5-13" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;7,0&quot; data-index-in-node=&quot;46&quot;&gt;Descripción:&lt;/b&gt; El usuario accede a la sección de ayuda y envía un reporte (error, denuncia, consulta o sugerencia) al equipo de administración." vertex="1">
