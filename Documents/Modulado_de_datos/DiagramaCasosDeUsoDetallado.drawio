        <mxCell id="8l5-s3TlvwDMKNyAavH5-11" parent="8l5-s3TlvwDMKNyAavH5-8" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Precondiciones:&lt;/b&gt;&amp;nbsp;El profesor debe estar dentro de la página de uno de sus propios cursos." vertex="1">
