        <mxCell id="sAzKu8gqVW-PRkbQ9jT1-21" parent="sAzKu8gqVW-PRkbQ9jT1-20" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;4,0&quot; data-index-in-node=&quot;57&quot;&gt;Descripción:&lt;/b&gt; El alumno accede a la página principal de bienvenida de la plataforma para descubrir contenido nuevo, continuar su aprendizaje y explorar categorías." vertex="1">
          <mxGeometry height="40" width="514" y="37" as="geometry" />
        </mxCell>
        <mxCell id="sAzKu8gqVW-PRkbQ9jT1-22" parent="sAzKu8gqVW-PRkbQ9jT1-20" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;4,0&quot; data-index-in-node=&quot;220&quot;&gt;Actores:&lt;/b&gt; Alumno" vertex="1">
