        <mxCell id="sAzKu8gqVW-PRkbQ9jT1-27" parent="sAzKu8gqVW-PRkbQ9jT1-25" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;7,0&quot; data-index-in-node=&quot;241&quot;&gt;Actores:&lt;/b&gt; Alumno" vertex="1">
