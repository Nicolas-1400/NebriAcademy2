        <mxCell id="8l5-s3TlvwDMKNyAavH5-24" parent="8l5-s3TlvwDMKNyAavH5-22" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Actores:&lt;/b&gt;&amp;nbsp;Alumno" vertex="1">
