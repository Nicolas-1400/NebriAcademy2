        </mxCell>
        <mxCell id="sAzKu8gqVW-PRkbQ9jT1-26" parent="sAzKu8gqVW-PRkbQ9jT1-25" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;7,0&quot; data-index-in-node=&quot;63&quot;&gt;Descripción:&lt;/b&gt; El alumno accede a su área privada para consultar, en formato de listas rápidas, los cursos y apuntes con los que interactúa habitualmente o que ha creado él mismo." vertex="1">
          <mxGeometry height="36" width="514" y="37" as="geometry" />
